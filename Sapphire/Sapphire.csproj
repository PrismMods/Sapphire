        <OutputType>Library</OutputType>
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>Sapphire</RootNamespace>
        <AssemblyName>Sapphire</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <FileAlignment>512</FileAlignment>
        <Deterministic>true</Deterministic>
        <!-- Never hardcode a developer's home here: it builds on exactly one machine and
             silently breaks every other clone. Defaults to the macOS Steam location under
             $(HOME); override with xbuild /p:AdofaiRoot=... for a non-standard install. -->
        <AdofaiRoot Condition=" '$(AdofaiRoot)' == '' ">$(HOME)/Library/Application Support/Steam/steamapps/common/A Dance of Fire and Ice</AdofaiRoot>
        <GameRoot>$(AdofaiRoot)</GameRoot>
        <AdofaiManaged>$(AdofaiRoot)/ADanceOfFireAndIce.app/Contents/Resources/Data/Managed</AdofaiManaged>
        <!-- Two supported loader layouts. MelonLoader + UMMCompat: HarmonyX 2.10 under
             MelonLoader/net472, the UMM shim under UserLibs/. Native UMM: both live in
             Managed/UnityModManager, with an OLDER Harmony — which is why the code must stay
             off 2.10-only APIs (see CLAUDE.md) and why either reference compiles the same source. -->
        <HarmonyDll Condition=" '$(HarmonyDll)' == '' AND Exists('$(GameRoot)/MelonLoader/net472/0Harmony.dll') ">$(GameRoot)/MelonLoader/net472/0Harmony.dll</HarmonyDll>
        <HarmonyDll Condition=" '$(HarmonyDll)' == '' ">$(AdofaiManaged)/UnityModManager/0Harmony.dll</HarmonyDll>
        <UmmDll Condition=" '$(UmmDll)' == '' AND Exists('$(GameRoot)/UserLibs/UnityModManager.dll') ">$(GameRoot)/UserLibs/UnityModManager.dll</UmmDll>
        <UmmDll Condition=" '$(UmmDll)' == '' ">$(AdofaiManaged)/UnityModManager/UnityModManager.dll</UmmDll>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
